<local:OverlayPanelWindow x:Class="WaffleMeter.App.Wpf.AetherPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WaffleMeter.App.Wpf"
        xmlns:controls="clr-namespace:WaffleMeter.App.Wpf.Controls"
        Title="컨텐츠 관리"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="CanResize"
        SizeToContent="Manual"
        Width="320" Height="460" MaxHeight="760" MinWidth="260" MinHeight="140"
        Left="40" Top="40"
        FontFamily="Segoe UI">
    <Window.Resources>
        <local:FontFamilyConverter x:Key="FontConv"/>

        <!-- Per-row ✕. Kept faint until the row is hovered so a list of characters doesn't read as a row of
             delete buttons, but never fully hidden — a control you can't see is a control you don't know about. -->
        <Style x:Key="RowRemoveButton" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0.35"/>
            <Setter Property="Foreground" Value="{DynamicResource Skin.MutedFg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="9" Background="Transparent">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#33FF6B6B"/>
                                <Setter Property="Foreground" Value="#FF8A8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 탭 알약 2개(컨텐츠 / 재화 관리). 전투 기록 패널의 HistoryTab 과 같은 알약이다 — 색 규칙은 상세창의
             Pill TabItem 과 같다. TabControl 이 아니라 RadioButton 인 이유도 같다: TabItem 은 키보드 포커스가
             옮겨 갈 때 선택되는데, 이 창은 WS_EX_NOACTIVATE 라 포커스를 받는다는 보장이 없다. 클릭으로
             바뀌는 RadioButton 은 그런 조건이 없고, 상호배타는 컨트롤이 보장한다. -->
        <Style x:Key="PanelTab" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="p" CornerRadius="6" Margin="0,0,6,0" Padding="11,5"
                                Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter x:Name="c" VerticalAlignment="Center"
                                              TextElement.Foreground="{DynamicResource Skin.MutedFg}"
                                              TextElement.FontSize="11.5" TextElement.FontWeight="SemiBold"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="p" Property="Background" Value="{DynamicResource Skin.RowHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="p" Property="Background" Value="{DynamicResource Skin.TabSelectedBg}"/>
                                <Setter TargetName="p" Property="BorderBrush" Value="{DynamicResource Skin.Accent}"/>
                                <Setter TargetName="c" Property="TextElement.Foreground" Value="{DynamicResource Skin.Fg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="6" BorderThickness="1"
            Background="{DynamicResource Skin.PanelBg}"
            BorderBrush="{DynamicResource Skin.Border}"
            TextElement.FontFamily="{Binding Settings.FontFamily, Converter={StaticResource FontConv}}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="6" Opacity="0.32" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header (drag handle) -->
            <Border Grid.Row="0" Background="{DynamicResource Skin.StatBg}" CornerRadius="6,6,0,0"
                    BorderBrush="{DynamicResource Skin.Border}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnDragHandle">
                <Grid Margin="12,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{DynamicResource Skin.MutedFg}"
                                   Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="컨텐츠 관리" Foreground="{DynamicResource Skin.Fg}" FontWeight="SemiBold"
                                   FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SummaryText}" Foreground="{DynamicResource Skin.MutedFg}"
                                   FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="&#xE8BB;" Click="OnCloseButton" ToolTip="닫기" HorizontalAlignment="Right"
                            Style="{StaticResource HeaderCloseButton}"/>
                </Grid>
            </Border>

            <!-- 탭: 컨텐츠 / 재화 관리. 오드 배지·트레이·'컨텐츠 관리' 단축키는 컨텐츠 탭으로, '재화 관리' 단축키는
                 재화 관리 탭으로 연다(AetherPanelEntry). -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,8,10,2">
                <RadioButton Style="{StaticResource PanelTab}" GroupName="AetherPanelTabs" Content="컨텐츠"
                             IsChecked="{Binding IsContentTab, Mode=TwoWay}"/>
                <RadioButton Style="{StaticResource PanelTab}" GroupName="AetherPanelTabs" Content="재화 관리"
                             IsChecked="{Binding IsCurrencyTab, Mode=TwoWay}"/>
            </StackPanel>

            <!-- Body: 컨텐츠 탭. 빈 안내의 여백(0,12)은 최소 높이(140)에서 둘째 줄까지 들어가는 값이다 — 탭 줄이
                 본문 높이를 가져간 뒤로 0,26 이면 '…자동으로 쌓입니다'가 잘린다. MinHeight 를 올리는 대신 여백을
                 줄인 건, 저장된 높이가 MinHeight 보다 작으면 LoadWindowSize 가 저장된 크기를 통째로 버리기 때문. -->
            <Grid Grid.Row="2" Visibility="{Binding ContentTabVisibility}">
                <TextBlock Text="아직 기록된 캐릭터가 없습니다&#x0a;캐릭터로 접속하면 자동으로 쌓입니다"
                           Foreground="{DynamicResource Skin.MutedFg}" FontSize="12" TextAlignment="Center"
                           HorizontalAlignment="Center" Margin="0,12" Visibility="{Binding EmptyVisibility}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="row" CornerRadius="8" Margin="8,3" MinHeight="62"
                                        Background="{DynamicResource Skin.StatBg}">
                                    <Grid Margin="12,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Skin.Fg}"
                                                           FontWeight="SemiBold" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Border Background="{DynamicResource Skin.AccentSoft}" CornerRadius="3"
                                                        Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding CurrentBadgeVisibility}">
                                                    <TextBlock Text="접속 중" Foreground="{DynamicResource Skin.Accent}"
                                                               FontSize="9" VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                <TextBlock Text="{Binding JobText}" Foreground="{DynamicResource Skin.MutedFg}"
                                                           FontSize="10" Visibility="{Binding JobVisibility}"/>
                                                <TextBlock Text=" · " Foreground="{DynamicResource Skin.MutedFg}"
                                                           FontSize="10" Visibility="{Binding JobVisibility}"/>
                                                <TextBlock Text="{Binding SeenText}" Foreground="{DynamicResource Skin.MutedFg}"
                                                           FontSize="10"/>
                                            </StackPanel>

                                            <!-- 주간 성역 클리어. The count is the SERVER's (it arrives on the same
                                                 0x610x resource packet as 오드, within half a second of the final
                                                 boss dying), so these chips are a readout, not a tally the meter
                                                 keeps. Clicking one overrides it for the weeks the meter wasn't
                                                 watching; the next broadcast still wins. -->
                                            <ItemsControl ItemsSource="{Binding Weekly}" Margin="0,5,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="chip" CornerRadius="4" Padding="4,2" Margin="0,0,4,0"
                                                                Background="Transparent" Cursor="Hand"
                                                                ToolTip="{Binding ToolTip}"
                                                                MouseLeftButtonUp="OnWeeklyChipClick">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Image Source="{Binding IconSource}" Width="14" Height="14"
                                                                       VerticalAlignment="Center" Margin="0,0,3,0"
                                                                       Opacity="{Binding IconOpacity}"
                                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                <TextBlock x:Name="count" Text="{Binding CountText}" FontSize="10"
                                                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource Skin.Fg}"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Cleared}" Value="True">
                                                                <Setter TargetName="count" Property="Foreground"
                                                                        Value="{DynamicResource Skin.MutedFg}"/>
                                                                <Setter TargetName="count" Property="FontWeight" Value="Normal"/>
                                                            </DataTrigger>
                                                            <Trigger SourceName="chip" Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="chip" Property="Background"
                                                                        Value="{DynamicResource Skin.RowHover}"/>
                                                            </Trigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- 어비스 회랑. A chip appears for a corridor this character's
                                                 진영 holds, as the server's own 점령 현황 broadcast
                                                 (0xE305/0xE307) states it — the same answer the game shows on
                                                 abyss entry. Never from a ticket value alone: a zero covers
                                                 미점령·소진·타종족·미방문 alike, and unspent time outlives the
                                                 occupation that granted it (2026-08-23), so the value only ever
                                                 supplies the NUMBER on a chip the broadcast already licensed.
                                                 A WrapPanel because six of these do not fit the 320px row. -->
                                            <ItemsControl ItemsSource="{Binding Corridors}" Margin="0,3,0,0"
                                                          Visibility="{Binding CorridorsVisibility}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <!-- A border rather than a fill: the row's own hover
                                                             state paints Skin.RowHover, so a chip filled with
                                                             that brush dissolves into the row the moment the
                                                             mouse arrives — exactly when it is being read. -->
                                                        <Border CornerRadius="4" Padding="4,1" Margin="0,2,4,0"
                                                                Background="Transparent" BorderThickness="1"
                                                                BorderBrush="{DynamicResource Skin.Border}"
                                                                ToolTip="{Binding ToolTip}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding TierText}" FontSize="9"
                                                                           VerticalAlignment="Center" Margin="0,0,3,0"
                                                                           Opacity="0.7"
                                                                           Foreground="{DynamicResource Skin.MutedFg}"/>
                                                                <TextBlock x:Name="corridorName" Text="{Binding Name}"
                                                                           FontSize="10" VerticalAlignment="Center"
                                                                           Opacity="{Binding NameOpacity}"
                                                                           Foreground="{DynamicResource Skin.Fg}"/>
                                                                <TextBlock x:Name="corridorTime" Text="{Binding TimeText}"
                                                                           FontSize="10" FontWeight="SemiBold"
                                                                           Margin="4,0,0,0" VerticalAlignment="Center"
                                                                           Foreground="#7EE7FF"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Spent}" Value="True">
                                                                <Setter TargetName="corridorTime" Property="Foreground"
                                                                        Value="{DynamicResource Skin.MutedFg}"/>
                                                                <Setter TargetName="corridorTime" Property="FontWeight"
                                                                        Value="Normal"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Ticking}" Value="True">
                                                                <Setter TargetName="corridorTime" Property="Foreground"
                                                                        Value="{DynamicResource Skin.Accent}"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- The empty state, and it says one of two different things — see
                                                 AetherRowViewModel.CorridorsEmptyText. With the 점령 현황 on
                                                 file the emptiness is a fact about the abyss; without it, only
                                                 a fact about our records. -->
                                            <TextBlock Text="{Binding CorridorsEmptyText}" FontSize="9" Margin="0,4,0,0"
                                                       Opacity="0.6"
                                                       Foreground="{DynamicResource Skin.MutedFg}"
                                                       ToolTip="{Binding CorridorsEmptyToolTip}"
                                                       Visibility="{Binding CorridorsEmptyVisibility}"/>
                                        </StackPanel>

                                        <!-- 오드 아이콘 + 자연회복 + (추가 오드). Same icon and split the meter's
                                             footer badge shows, so the two read as the same number. -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                                                    Margin="10,0,0,0">
                                            <Image Source="pack://application:,,,/WaffleMeter.App.Wpf;component/Icons/ode.png"
                                                   Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,4,0"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="{Binding BaseText}" Foreground="#7EE7FF"
                                                       FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding BonusText}" Foreground="#7EE7FF" Opacity="0.66"
                                                       FontSize="11" Margin="3,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding BonusVisibility}"/>
                                        </StackPanel>

                                        <Button x:Name="remove" Grid.Column="2" Style="{StaticResource RowRemoveButton}"
                                                Margin="8,0,0,0" VerticalAlignment="Top"
                                                ToolTip="{Binding RemoveTooltip}" Click="OnRemoveClick"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="row" Property="Background" Value="{DynamicResource Skin.RowHover}"/>
                                        <Setter TargetName="remove" Property="Opacity" Value="1"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Body: 재화 관리 탭. 컨텐츠 탭과 같은 캐릭터를 같은 순서(접속 중 캐릭터 먼저)로, 그 아래 서버별 총 키나. -->
            <Grid Grid.Row="2" Visibility="{Binding CurrencyTabVisibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 아무 재화도 기록되지 않았으면 대시만 줄줄이 찍힌 목록 대신 이것 하나를 띄운다. 여백은 컨텐츠 탭
                     빈 안내와 같은 이유로 0,12. -->
                <TextBlock Text="아직 기록된 재화가 없습니다&#x0a;캐릭터를 선택해 접속하면 채워집니다"
                           Foreground="{DynamicResource Skin.MutedFg}" FontSize="12" TextAlignment="Center"
                           HorizontalAlignment="Center" Margin="0,12" Visibility="{Binding CurrencyEmptyVisibility}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4"
                              Visibility="{Binding CurrencyListVisibility}">
                    <ItemsControl ItemsSource="{Binding CurrencyRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Margin="8,3" Background="{DynamicResource Skin.StatBg}">
                                    <Grid Margin="12,7">
                                        <Grid.Resources>
                                            <!-- One currency = one small card: icon on the left, compact value
                                                 pushed to the right edge so the figures line up down the list;
                                                 exact value in the tooltip. The card is the row's own StatBg laid
                                                 once more (an inset in every skin) with the soft border for an edge.
                                                 IconValuePanel stacks the icon above the value when the card gets
                                                 too narrow (the 260px minimum width) instead of trimming the figure;
                                                 each row sets its own width for that via StackBelow below. A balance
                                                 never seen dims its content, not the card, so the grid keeps its
                                                 shape. -->
                                            <DataTemplate x:Key="CurrencyCell">
                                                <Border Margin="2" Padding="6,4" CornerRadius="6"
                                                        Background="{DynamicResource Skin.StatBg}"
                                                        BorderBrush="{DynamicResource Skin.SoftBorder}"
                                                        BorderThickness="1" ToolTip="{Binding ToolTip}">
                                                    <controls:IconValuePanel Opacity="{Binding Opacity}" Spacing="5">
                                                        <Image Source="{Binding IconSource}" Width="16" Height="16"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <TextBlock Text="{Binding ValueText}" FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource Skin.Fg}"/>
                                                    </controls:IconValuePanel>
                                                </Border>
                                            </DataTemplate>
                                        </Grid.Resources>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Left-aligned (*, Auto): the badge sits right after the name, and
                                                 a name too long for the row trims instead of running under the
                                                 age on the right. -->
                                            <Grid Grid.Column="0" HorizontalAlignment="Left">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                           Foreground="{DynamicResource Skin.Fg}"
                                                           FontWeight="SemiBold" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Border Grid.Column="1" Background="{DynamicResource Skin.AccentSoft}"
                                                        CornerRadius="3" Padding="4,0" Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding CurrentBadgeVisibility}">
                                                    <TextBlock Text="접속 중" Foreground="{DynamicResource Skin.Accent}"
                                                               FontSize="9" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="{Binding SeenText}" FontSize="10"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Background="Transparent" ToolTip="{Binding SeenToolTip}"
                                                       Foreground="{DynamicResource Skin.MutedFg}"/>
                                        </Grid>

                                        <!-- 재화 다섯: 키나(각인) · 키나 · 어비스 포인트 · 몽환의 파편 · 극복의 증표, each the
                                             server's own number from the item packets (0x5611 snapshot / 0x561B
                                             changes) as last seen on this character. Korean units in the cell, the
                                             exact figure in the tooltip; a balance never seen reads "—", never 0.
                                             Two fixed lines rather than one wrapping row: the kinah pair (the only
                                             balances that reach 억 — "13억 2,945만" is the widest realistic value)
                                             at half the row each, the three point currencies at a third. That fits
                                             the 260px minimum as well as the 320px default, and keeps every
                                             currency in the same column from one character to the next. -->
                                        <!-- -2 sideways: the cards' own 2px margin, so their outer edges line
                                             up with the name above instead of sitting 2px in. StackBelow is the
                                             card width (inside padding) under which a row's cards stack: the
                                             widest realistic kinah, "13억 2,945만", needs ~94 beside its icon; a
                                             point figure like "25,611" ~62. Both rows stay side by side at the
                                             320px default and stack at the 260px minimum. -->
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding KinaCells}" Margin="-2,4,-2,0"
                                                      controls:IconValuePanel.StackBelow="94"
                                                      ItemTemplate="{StaticResource CurrencyCell}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="2"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <ItemsControl Grid.Row="2" ItemsSource="{Binding PointCells}" Margin="-2,0"
                                                      controls:IconValuePanel.StackBelow="62"
                                                      ItemTemplate="{StaticResource CurrencyCell}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="3"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 서버별 총 키나 — one line per server: every character's own kinah (각인 + 거래 가능 + 캐릭터 창고)
                     plus the 서버 창고 counted ONCE (it is shared by the server's characters, so summing it per row
                     would multiply it). Pinned under the list rather than scrolled with it: it is the sum OF the
                     list. -->
                <Border Grid.Row="1" Background="{DynamicResource Skin.StatBg}" CornerRadius="0,0,6,6"
                        BorderBrush="{DynamicResource Skin.Border}" BorderThickness="0,1,0,0"
                        Visibility="{Binding ServerKinaVisibility}">
                    <ItemsControl ItemsSource="{Binding ServerKina}" Margin="12,5,12,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1" Background="Transparent" ToolTip="{Binding ToolTip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="pack://application:,,,/WaffleMeter.App.Wpf;component/Icons/currency_kina_total.png"
                                               Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="총 키나" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Skin.MutedFg}"/>
                                        <TextBlock Text="{Binding ServerText}" FontSize="10" Margin="5,0,0,0"
                                                   VerticalAlignment="Center" Opacity="0.8"
                                                   Foreground="{DynamicResource Skin.MutedFg}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding StorageText}" FontSize="9" Margin="8,0"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.7"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Skin.MutedFg}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TotalText}" FontSize="12"
                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Skin.Fg}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Grid>
        </Grid>
    </Border>
</local:OverlayPanelWindow>
