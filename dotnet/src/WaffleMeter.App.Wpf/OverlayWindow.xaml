<Window x:Class="WaffleMeter.App.Wpf.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WaffleMeter.App.Wpf"
        Title="waffle_meter"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="CanResize"
        SizeToContent="Height"
        Width="490" Height="300" MinWidth="320" MinHeight="150"
        Left="40" Top="40"
        UseLayoutRounding="True"
        FontFamily="Segoe UI">
    <Window.Resources>
        <local:RatioToStarConverter x:Key="RatioToStar"/>
        <local:FontFamilyConverter x:Key="FontConv"/>
        <local:RowHeightToFontSizeConverter x:Key="FontSize"/>
        <local:OffsetConverter x:Key="Offset"/>
        <local:PercentToScaleConverter x:Key="PercentScale"/>

        <!-- HeaderIconButton / HeaderCloseButton live in Themes/PanelChrome.xaml (merged app-wide) so the
             meter header and every panel share one button look + tooltip timing. -->
        <!-- Compact opacity slider: thin rounded track, accent fill left of the thumb, small round thumb
             (replaces the default WPF chrome that clashed with the dark overlay). -->
        <Style x:Key="OpacitySlider" TargetType="Slider">
            <Setter Property="Height" Value="16"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource Skin.ControlBg}"
                                    BorderBrush="{DynamicResource Skin.SoftBorder}" BorderThickness="1"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource Skin.Accent}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="12" Height="12" CornerRadius="6" Cursor="Hand"
                                                        Background="{DynamicResource Skin.Fg}" BorderBrush="{DynamicResource Skin.Accent}" BorderThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="설정" Click="OnSettings"/>
            <MenuItem Header="종료" Click="OnExit"/>
        </ContextMenu>
    </Window.ContextMenu>
    <Border CornerRadius="6" Padding="10,8"
            TextElement.FontFamily="{Binding Settings.FontFamily, Converter={StaticResource FontConv}}">
        <!-- 미터 크기(배율): 루트에 LayoutTransform을 걸어 글자·행·여백까지 균일 확대/축소. SizeToContent=Height라
             높이는 스케일된 콘텐츠에 자동으로 다시 맞춰진다. 폭(Window.Width)은 사용자가 계속 드래그로 조절. -->
        <Border.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Settings.MeterScalePercent, Converter={StaticResource PercentScale}}"
                            ScaleY="{Binding Settings.MeterScalePercent, Converter={StaticResource PercentScale}}"/>
        </Border.LayoutTransform>
        <Border.Background>
            <SolidColorBrush Color="{DynamicResource Skin.OverlayBgColor}" Opacity="{Binding Settings.MeterOpacity}"/>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- left: drag handle + opacity control (React Header left side) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            MouseLeftButtonDown="OnDragHandle" Background="Transparent">
                    <TextBlock Text="투명도" Foreground="{DynamicResource Skin.MutedFg}" FontSize="10" VerticalAlignment="Center" Margin="2,0,6,0"/>
                    <!-- Minimum=0 restores the old (1.7.x React) slider's full transparency range. MeterOpacity
                         feeds ONLY the panel background brush (line ~79), never Window.Opacity, so even at 0 the
                         rows/text/header buttons keep their own opacity and the window stays clickable. -->
                    <Slider Style="{StaticResource OpacitySlider}" Width="92" VerticalAlignment="Center" Minimum="0.0" Maximum="1.0"
                            SmallChange="0.05" LargeChange="0.1" Value="{Binding Settings.MeterOpacity, Mode=TwoWay}"/>
                </StackPanel>
                <!-- right: control buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- click-through lock badge: non-interactive, shown only while input pass-through is active
                         (React Header LockKeyhole). The window is WS_EX_TRANSPARENT then, so it's a pure visual cue. -->
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#FFD400"
                               VerticalAlignment="Center" Margin="2,0,6,0" IsHitTestVisible="False"
                               ToolTip="클릭스루 잠금 — 입력이 게임으로 통과 중"
                               Visibility="{Binding ClickThroughVisibility}"/>
                    <!-- update-available badge: only visible once an update is downloaded; click opens the
                         restart toast on demand (no auto-popup). -->
                    <Button Style="{StaticResource HeaderIconButton}" Content="&#xE777;" Foreground="{DynamicResource Skin.Accent}"
                            Click="OnUpdateButton" ToolTip="{Binding UpdateTooltip}" Visibility="{Binding UpdateReadyVisibility}"/>
                    <Button Style="{StaticResource HeaderIconButton}" Content="&#xE771;" Click="OnThemeButton" ToolTip="테마 변경"/>
                    <Button Style="{StaticResource HeaderIconButton}" Content="&#xE72C;" Click="OnResetButton" ToolTip="전투 초기화"/>
                    <!-- 허수아비 테스트 토글: accent while ON (bound to the shared MeterSettings flag). -->
                    <Button Content="&#xE916;" Click="OnDummyTestButton"
                            ToolTip="허수아비 테스트 모드 — 켜면 허수아비 타격이 전투로 집계됩니다 (설정 › 허수아비)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource HeaderIconButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Settings.DummyTestMode}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Skin.Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource HeaderIconButton}" Content="&#xE8A7;" Click="OnTaskbarButton" ToolTip="작업표시줄 / Alt+Tab 모드"/>
                    <Button Style="{StaticResource HeaderIconButton}" Content="&#xE8FA;" Click="OnJoinButton" ToolTip="파티 신청"/>
                    <Button Style="{StaticResource HeaderIconButton}" Content="&#xE81C;" Click="OnHistoryButton" ToolTip="전투 기록"/>
                    <Button Style="{StaticResource HeaderIconButton}" Content="&#xE713;" Click="OnSettingsButton" ToolTip="설정"/>
                    <Button Style="{StaticResource HeaderCloseButton}" Content="&#xE8BB;" Click="OnExitButton" ToolTip="종료"/>
                </StackPanel>
            </Grid>

            <!-- target-info bar (React TargetInfo.tsx): above the rows, shown when there are rows -->
            <Border Grid.Row="1" CornerRadius="6" Padding="8,0" Margin="0,0,0,6" ClipToBounds="True"
                    Height="{Binding Settings.RowHeight, Converter={StaticResource Offset}, ConverterParameter=6}"
                    Background="{DynamicResource Skin.RowBg}" BorderBrush="{DynamicResource Skin.SoftBorder}" BorderThickness="1"
                    Visibility="{Binding TargetInfoVisibility}">
                <Grid>
                    <!-- "fill" HP gauge (게이지 형태 = fill): proportional cell fill behind the content at low
                         opacity so the boss name stays readable — mirrors the meter row fill. -->
                    <Grid Visibility="{Binding TargetBarFillVisibility}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding TargetHpRatio, Converter={StaticResource RatioToStar}}"/>
                            <ColumnDefinition Width="{Binding TargetHpRest, Converter={StaticResource RatioToStar}}"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{Binding BossBarBrush}" Opacity="0.3" CornerRadius="4"/>
                    </Grid>
                    <!-- "bar" HP gauge (게이지 형태 = bar): thin bottom HP-fill bar. "none" hides both. -->
                    <Grid VerticalAlignment="Bottom" Height="2" Visibility="{Binding TargetBottomBarVisibility}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding TargetHpRatio, Converter={StaticResource RatioToStar}}"/>
                            <ColumnDefinition Width="{Binding TargetHpRest, Converter={StaticResource RatioToStar}}"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{Binding BossBarBrush}"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- left accent rail -->
                        <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,4,8,4" Background="{Binding BossBarBrush}"/>
                        <Image Grid.Column="1" Source="{Binding BossIcon}" Width="20" Height="20" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding TargetName}" Foreground="{DynamicResource Skin.Fg}" FontWeight="SemiBold"
                                   FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="3" Text="{Binding TargetHpText}" Foreground="{Binding CombatTimeBrush}" FontSize="12"
                                   VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding TargetHpVisibility}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 행 목록. 이 ScrollViewer는 v2.8.0 마크업을 그대로 되돌린 것이고, 실측상 관측 가능한 역할이 없다:
                 자동 맞춤(SizeToContent="Height")에서는 VerticalScrollBarVisibility="Disabled"가 세로 제약을
                 그대로 통과시켜 있으나 없으나 창 높이가 같고(1/5/10/24행 모두 동일), 높이를 고정한 상태에서도
                 넘치는 행은 WPF 레이아웃 클립이 이미 잘라내 렌더 결과가 픽셀 단위로 같다.
                 ※ v2.8.1은 이걸 "높이가 안 늘어나는 원인"으로 지목해 제거했으나 오진이었다. 진짜 원인은 WPF가
                    크기 조절 시작 시점에 SizeToContent를 꺼버리는 것 — WindowResizePolicy 참조. -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
            <TextBlock Text="전투 대기 중" Foreground="{DynamicResource Skin.MutedFg}" HorizontalAlignment="Center"
                       Margin="0,8" Visibility="{Binding PlaceholderVisibility}"/>

            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="6" Padding="5,3" Margin="0,1" Cursor="Hand" BorderThickness="1"
                                ClipToBounds="True" MouseLeftButtonUp="OnRowClick" MinHeight="{Binding RowHeight}"
                                Typography.NumeralAlignment="Tabular">
                            <Border.Style>
                                <!-- Resting card fill + soft border (matches React .meter-row); hover lightens.
                                     A tiered row carries its tier colour on the OUTLINE as well — the rings on
                                     two 20px badges alone were easy to miss at a glance. The untiered path is
                                     unchanged, hover included, so the feature-off render stays pixel-identical. -->
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Skin.RowBg}"/>
                                    <Setter Property="BorderBrush" Value="{Binding Tier.RowBorder}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tier.IsNone}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Skin.SoftBorder}"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Skin.RowHover}"/>
                                        </Trigger>
                                        <!-- hover on an untiered row still lightens the outline, exactly as before -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Tier.IsNone}" Value="True"/>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="BorderBrush" Value="{DynamicResource Skin.Border}"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <!-- thick "fill" gauge behind the content (barStyle=fill): a proportional
                                         FillBrush panel at low opacity so the row text stays readable on top. -->
                                    <Grid Visibility="{Binding BarFillVisibility}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding BarRatio, Converter={StaticResource RatioToStar}}"/>
                                            <ColumnDefinition Width="{Binding BarRest, Converter={StaticResource RatioToStar}}"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{Binding FillBrush}" Opacity="0.3" CornerRadius="4"/>
                                    </Grid>
                                  <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- left accent rail -->
                                    <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,2,8,2" VerticalAlignment="Stretch"
                                            Background="{Binding FillBrush}" Opacity="{Binding AccentOpacity}"/>
                                    <!-- rank — 던전 티어 tints the fill/ring/number. Every dimension (MinWidth,
                                         Height, Padding, Margin, BorderThickness, CornerRadius) is UNCHANGED:
                                         the window is SizeToContent="Height" and growing a badge by a pixel
                                         re-opens the auto-height regression that bit v2.7.5 and v2.8.1.
                                         Tier.IsNone restores the skin's own brushes so an untiered row (or the
                                         feature switched off) is pixel-identical to before across all 4 skins. -->
                                    <Border Grid.Column="1" BorderThickness="1" SnapsToDevicePixels="True"
                                            CornerRadius="4" MinWidth="22" Height="20" Padding="4,0" Margin="0,0,6,0" VerticalAlignment="Center"
                                            ToolTip="{Binding TierInfo.ToolTip}" ToolTipService.IsEnabled="{Binding TierInfo.HasToolTip}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{Binding Tier.RankBg}"/>
                                                <Setter Property="BorderBrush" Value="{Binding Tier.RankRing}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tier.IsNone}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Skin.StatBg}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Skin.SoftBorder}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Rank}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="{Binding RowHeight, Converter={StaticResource FontSize}, ConverterParameter='0.32:9'}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{Binding Tier.RankFg}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tier.IsNone}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Skin.MutedFg}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <!-- job icon — the tier ring replaces Skin.IconRing; the second ring for the
                                         top three tiers is a size-less Grid child, so it contributes nothing to
                                         DesiredSize and the badge keeps its exact dimensions. -->
                                    <Border Grid.Column="2" Background="{DynamicResource Skin.StatBg}" BorderThickness="1" SnapsToDevicePixels="True"
                                            CornerRadius="6" Margin="0,0,8,0" VerticalAlignment="Center"
                                            Width="{Binding RowHeight, Converter={StaticResource FontSize}, ConverterParameter='0.66:18'}"
                                            Height="{Binding RowHeight, Converter={StaticResource FontSize}, ConverterParameter='0.66:18'}"
                                            ToolTip="{Binding TierInfo.ToolTip}" ToolTipService.IsEnabled="{Binding TierInfo.HasToolTip}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{Binding Tier.IconRing}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tier.IsNone}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Skin.IconRing}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Image Source="{Binding IconSource}" Stretch="Uniform" Margin="2"/>
                                            <!-- IsHitTestVisible=False: the row is a click target (OnRowClick) and a
                                                 transparent overlay hit-tests per-pixel alpha, so a decorative ring
                                                 must never become clickable. -->
                                            <Border CornerRadius="4.5" BorderThickness="1" IsHitTestVisible="False" SnapsToDevicePixels="True"
                                                    BorderBrush="{Binding Tier.InnerRing}" Visibility="{Binding Tier.InnerRingVisibility}"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- NameFillBrush 는 효과가 없으면 NameBrush 와 같은 객체다 — 후원자·랭커
                                             연출이 꺼져 있으면 이 줄은 도입 전과 픽셀 단위로 동일하다. 요소를
                                             더하지 않고 Foreground 만 바꾸므로 DesiredSize 가 불변이고,
                                             SizeToContent="Height" 자동 높이 재계산도 일어나지 않는다. -->
                                        <TextBlock Text="{Binding Name}" Foreground="{Binding NameFillBrush}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="150" FontFamily="{Binding NameFontFamily}"
                                                   FontSize="{Binding RowHeight, Converter={StaticResource FontSize}, ConverterParameter='0.4:10'}"/>
                                        <!-- restored bracketed server tag; own element so masking/ellipsis can't eat it -->
                                        <TextBlock Text="{Binding ServerTag, StringFormat='[{0}]'}" Foreground="{Binding NameBrush}"
                                                   VerticalAlignment="Center" Margin="3,0,0,0" Visibility="{Binding ServerTagVisibility}"
                                                   FontSize="{Binding RowHeight, Converter={StaticResource FontSize}, ConverterParameter='0.34:9'}"/>
                                        <Border Background="{DynamicResource Skin.StatBg}" BorderBrush="{DynamicResource Skin.SoftBorder}" BorderThickness="1" CornerRadius="4"
                                                Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding PowerVisible}">
                                            <TextBlock Text="{Binding PowerText}" Foreground="{Binding PowerBrush}"
                                                       FontSize="{Binding RowHeight, Converter={StaticResource FontSize}, ConverterParameter='0.32:9'}"/>
                                        </Border>
                                    </StackPanel>
                                    <!-- 이번 전투 상위 X.X% — per player, computed locally from the downloaded
                                         distribution (this row's dps against its own class cohort). No server
                                         call and nothing about anyone's account: it is derived from the same
                                         combat packets the row already shows. Its own Auto column so it can
                                         never be clipped by the name column, and Collapsed when the cohort had
                                         no shipped distribution row (표본 부족 — we never guess a number). -->
                                    <Border Grid.Column="4" Background="{Binding Tier.ChipBg}" BorderBrush="{Binding Tier.RankRing}" BorderThickness="1"
                                            CornerRadius="4" Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center" SnapsToDevicePixels="True"
                                            Visibility="{Binding TierInfo.PercentVisibility}" ToolTip="{Binding TierInfo.ToolTip}">
                                        <TextBlock Text="{Binding TierInfo.PercentText}" Foreground="{Binding Tier.ChipFg}" FontWeight="SemiBold"
                                                   FontSize="{Binding RowHeight, Converter={StaticResource FontSize}, ConverterParameter='0.32:9'}"/>
                                    </Border>
                                    <Border Grid.Column="5" Background="{DynamicResource Skin.StatBg}" BorderBrush="{DynamicResource Skin.SoftBorder}" BorderThickness="1"
                                            CornerRadius="4" Padding="5,0" Margin="6,0,4,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DamageText}" Foreground="{Binding DamageBrush}"
                                                   FontSize="{Binding RowHeight, Converter={StaticResource FontSize}, ConverterParameter='0.4:10'}"/>
                                    </Border>
                                    <Border Grid.Column="6" Background="{DynamicResource Skin.StatBg}" BorderBrush="{DynamicResource Skin.SoftBorder}" BorderThickness="1"
                                            CornerRadius="4" Padding="5,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PercentText}" Foreground="{Binding PercentBrush}" MinWidth="40" TextAlignment="Center"
                                                   FontSize="{Binding RowHeight, Converter={StaticResource FontSize}, ConverterParameter='0.4:10'}"/>
                                    </Border>
                                  </Grid>
                                </Grid>
                                <Grid Grid.Row="1" Height="3" Margin="0,3,0,0" Visibility="{Binding BottomBarVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding BarRatio, Converter={StaticResource RatioToStar}}"/>
                                        <ColumnDefinition Width="{Binding BarRest, Converter={StaticResource RatioToStar}}"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{Binding FillBrush}" CornerRadius="1.5"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
            </ScrollViewer>

            <!-- combat-timer pill (React CombatTimer.tsx): below the rows -->
            <Border Grid.Row="3" CornerRadius="6" Padding="8,3" Margin="0,6,0,0"
                    Background="{DynamicResource Skin.RowBg}" BorderBrush="{DynamicResource Skin.SoftBorder}" BorderThickness="1"
                    Visibility="{Binding CombatTimerVisibility}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding CombatStatusBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding CombatStatusText}" Foreground="{Binding CombatStatusBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <!-- 이번 전투 상위 X.X% (self only). It lives HERE and not on the row because the row's
                         420px default width is already fully spent on name/server/power — a chip there gets
                         clipped at the column boundary. This is also the honest place for it: it is one
                         number about one fight, not a per-player column. -->
                    <Border Grid.Column="2" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Center"
                            BorderThickness="1" CornerRadius="4" Padding="6,0" SnapsToDevicePixels="True"
                            Background="{Binding SelfTierChipBg}" BorderBrush="{Binding SelfTierChipRing}"
                            Visibility="{Binding SelfTierChipVisibility}" ToolTip="{Binding SelfTierChipToolTip}">
                        <!-- FontSize 10 + zero vertical padding keeps the first line inside the timer row's
                             existing line height. -->
                        <StackPanel>
                            <TextBlock Text="{Binding SelfTierChipText}" Foreground="{Binding SelfTierChipFg}"
                                       FontSize="10" FontWeight="SemiBold"/>
                            <!-- 무엇과 비교한 값인지. 인라인으로 붙는다 — 툴팁에만 두면 전체 구간으로 폴백된
                                 사람이 그 사실을 모른 채 지나간다. 서버가 전투력 구간 분포를 아직 안 내보내면
                                 "전체 전투력 기준"이 뜨고, 내보내기 시작하면 같은 자리 문구만 바뀐다.
                                 LineHeight를 글자 크기에 맞춰 눌러 두 번째 줄이 더하는 높이를 최소로 잡는다. -->
                            <TextBlock Text="{Binding SelfTierChipBasis}" Foreground="{Binding SelfTierChipFg}"
                                       Visibility="{Binding SelfTierChipBasisVisibility}"
                                       FontSize="9" Opacity="0.75" LineHeight="10" LineStackingStrategy="BlockLineHeight"
                                       Margin="0,-1,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Column="3" Text="{Binding Duration}" Foreground="{Binding CombatTimeBrush}" FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Grid Grid.Row="4" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- left: capture / recognized status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Skin.MutedFg}" FontSize="10" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding RecognizedStatus}" Foreground="{Binding CombatStatusBrush}" FontSize="10" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="6,0,0,0" Visibility="{Binding RecognizedVisibility}"/>
                </StackPanel>
                <!-- right: resource badges (오드 / 슈고 열쇠 / ping) with icons, pinned to the footer's right end -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 오드: the game's own 오드 에너지 icon + 자연회복(+추가) -->
                    <!-- Clickable: opens the per-character 오드 list. MouseLeftButtonUp on the Border (not a
                         Button) matches the row-click pattern above and keeps the footer's height unchanged —
                         a Button's default template would add chrome and risk the SizeToContent regression. -->
                    <Border Margin="6,0,0,0" Padding="5,1" CornerRadius="4" VerticalAlignment="Center" Cursor="Hand"
                            Background="{DynamicResource Skin.StatBg}" Visibility="{Binding AetherVisibility}"
                            MouseLeftButtonUp="OnAetherBadgeClick"
                            ToolTip="{Binding AetherToolTip}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/WaffleMeter.App.Wpf;component/Icons/ode.png"
                                   Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,4,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="{Binding AetherText}" Foreground="#7EE7FF" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- 슈고 페스타 열쇠: a gold key icon + base(+bonus) -->
                    <Border Margin="6,0,0,0" Padding="5,1" CornerRadius="4" VerticalAlignment="Center"
                            Background="{DynamicResource Skin.StatBg}" Visibility="{Binding ShugoKeyVisibility}" ToolTip="슈고 페스타 열쇠">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 3,0 A 3,3 0 1 0 3.01,0 M 4,4 L 4,10 M 4,7 L 6.5,7" Stroke="#FFD98A" StrokeThickness="1.4"
                                  Width="10" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding ShugoKeyText}" Foreground="#FFD98A" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- server latency (ping) -->
                    <Border Margin="6,0,0,0" Padding="5,1" CornerRadius="4" VerticalAlignment="Center"
                            Background="{DynamicResource Skin.StatBg}" Visibility="{Binding PingVisibility}" ToolTip="게임 서버 응답속도">
                        <TextBlock Text="{Binding PingText}" Foreground="{DynamicResource Skin.MutedFg}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
