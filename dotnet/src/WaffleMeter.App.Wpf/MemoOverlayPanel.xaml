<local:OverlayPanelWindow x:Class="WaffleMeter.App.Wpf.MemoOverlayPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WaffleMeter.App.Wpf"
        Title="메모"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="CanResize"
        SizeToContent="Manual"
        Width="260" Height="160" MinWidth="150" MinHeight="64"
        Left="40" Top="40"
        UseLayoutRounding="True"
        FontFamily="Segoe UI">
    <Window.Resources>
        <local:FontFamilyConverter x:Key="FontConv"/>

        <!-- 미터 헤더의 OpacitySlider(OverlayWindow.xaml 창 리소스)와 같은 모양. 그쪽은 창 리소스라 여기서
             참조할 수 없어 복사해 둔다 — 두 슬라이더가 나란히 보일 일이 많으니 모양이 갈리면 안 된다. -->
        <Style x:Key="MemoOpacitySlider" TargetType="Slider">
            <Setter Property="Height" Value="16"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource Skin.ControlBg}"
                                    BorderBrush="{DynamicResource Skin.SoftBorder}" BorderThickness="1"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource Skin.Accent}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="12" Height="12" CornerRadius="6" Cursor="Hand"
                                                        Background="{DynamicResource Skin.Fg}" BorderBrush="{DynamicResource Skin.Accent}" BorderThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 편집 상자. 오버레이 창은 Skin.Controls.xaml 을 병합하지 않으므로(설정창 전용) 기본 Aero 흰 상자가
             뜨지 않게 템플릿을 직접 준다. 읽기 화면과 같은 글씨·색에 얇은 액센트 테두리만 더해 '지금 입력 중'을
             알린다. -->
        <Style x:Key="MemoEditBox" TargetType="TextBox">
            <Setter Property="Background" Value="#33000000"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Skin.Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,1"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid TextElement.FontFamily="{Binding Settings.FontFamily, Converter={StaticResource FontConv}}">
        <!-- ① 알파 1/255 바닥(잠금 해제 중에만). 레이어드 창은 알파 0 픽셀에서 클릭이 통과하므로, 투명도 0 의
             메모도 드래그·가장자리 리사이즈·더블클릭이 살아 있으려면 창 전체에 보이지 않는 바닥이 필요하다. -->
        <Border CornerRadius="6" Background="#01000000" Visibility="{Binding HitFloorVisibility}"/>

        <!-- ② 배경 = 스킨 색 × memo.opacity. ⚠️ Window.Opacity 로 하지 마라 — Present() 가 부를 때마다 1 로
             덮어쓴다(OverlayPanelWindow). 미터와 같은 방식(브러시 알파)이다. -->
        <Border CornerRadius="6" IsHitTestVisible="False">
            <Border.Background>
                <SolidColorBrush Color="{DynamicResource Skin.OverlayBgColor}" Opacity="{Binding Settings.MemoOpacity}"/>
            </Border.Background>
        </Border>

        <!-- ③ 테두리. 투명도 최하에서는 지운다(글자와 슬라이더만 남긴다). -->
        <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Skin.Border}"
                IsHitTestVisible="False" Visibility="{Binding ChromeVisibility}"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 머리줄 띠. 배경과 같이 투명도를 따라 옅어지다가 최하에서 사라진다. -->
            <Border Grid.Row="0" CornerRadius="6,6,0,0" Background="{DynamicResource Skin.StatBg}"
                    Opacity="{Binding Settings.MemoOpacity}" Visibility="{Binding ChromeVisibility}"
                    IsHitTestVisible="False"/>

            <!-- Header (drag handle) -->
            <Grid Grid.Row="0" Margin="10,3,4,3" Background="Transparent" MouseLeftButtonDown="OnDragHandle">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding ChromeVisibility}">
                    <TextBlock Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                               Foreground="{DynamicResource Skin.MutedFg}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="메모" Foreground="{DynamicResource Skin.Fg}" FontWeight="SemiBold"
                               FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- 메모 자기 투명도. 미터 투명도(meterOpacity)와 별개의 키이고, 설정 '메모' 탭 슬라이더와
                     같은 경로(Settings.MemoOpacity)로 묶는다. 투명도 최하에서도 이것과 글자는 남는다. -->
                <Slider Grid.Column="1" Style="{StaticResource MemoOpacitySlider}" Width="64" Margin="6,0,4,0"
                        VerticalAlignment="Center" Minimum="0.0" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"
                        Value="{Binding Settings.MemoOpacity, Mode=TwoWay}" ToolTip="메모 배경 투명도"/>
                <!-- 잠금 버튼. 배경을 알파 1 로 깐다 — 템플릿의 Transparent 그대로면 글리프 획 밖은 레이어드
                     창이 클릭을 통과시켜 버튼 사각형 전체가 눌리지 않는다. ClickMode=Press: 잠긴 창은 Ctrl 을
                     쥐고 있는 동안만 눌리므로, 누르는 그 순간에 Ctrl 을 확인하고 끝낸다(떼기 전에 Ctrl 을 놓아도
                     판정이 흔들리지 않는다). -->
                <Button x:Name="LockButton" Grid.Column="2" Background="#01000000" ClickMode="Press"
                        Content="{Binding LockGlyph}" ToolTip="{Binding LockToolTip}"
                        Visibility="{Binding LockButtonVisibility}" Click="OnLockButton">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource HeaderIconButton}">
                            <Style.Triggers>
                                <!-- 잠긴 동안은 미터 헤더의 클릭스루 배지와 같은 노란색. -->
                                <DataTrigger Binding="{Binding Settings.MemoLocked}" Value="True">
                                    <Setter Property="Foreground" Value="#FFD400"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Grid.Column="3" Content="&#xE8BB;" Click="OnCloseButton" ToolTip="메모 닫기"
                        Style="{StaticResource HeaderCloseButton}" Visibility="{Binding ChromeVisibility}"/>
            </Grid>

            <!-- Body. 표면 드래그(4px 넘게 움직일 때만)와 더블클릭 편집을 같이 받는다 — 투명도 0 에서는 머리줄이
                 안 보여 어디를 잡아야 할지 모르므로 본문으로도 옮길 수 있게 둔다. -->
            <Grid Grid.Row="1" Margin="10,2,6,8" Background="Transparent"
                  MouseLeftButtonDown="OnBodyMouseDown" MouseMove="OnDragSurfaceMove" MouseLeftButtonUp="OnDragSurfaceUp">
                <!-- Focusable=False: ScrollViewer 는 포커스를 잡을 수 있으면 MouseLeftButtonDown 을 Handled 로 삼켜
                     더블클릭이 본문까지 안 온다. -->
                <ScrollViewer Focusable="False" VerticalScrollBarVisibility="{Binding ReadScrollBarVisibility}"
                              HorizontalScrollBarVisibility="Disabled" Visibility="{Binding ReadVisibility}">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" Foreground="{Binding TextBrush}"/>
                </ScrollViewer>
                <TextBlock Text="더블클릭해서 메모를 적으세요" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource Skin.MutedFg}" IsHitTestVisible="False"
                           Visibility="{Binding PlaceholderVisibility}"/>
                <TextBox x:Name="EditBox" Style="{StaticResource MemoEditBox}" Visibility="{Binding EditVisibility}"
                         FontSize="13" Foreground="{Binding TextBrush}" CaretBrush="{Binding TextBrush}"
                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         PreviewKeyDown="OnEditKeyDown"
                         GotKeyboardFocus="OnEditGotKeyboardFocus" LostKeyboardFocus="OnEditLostKeyboardFocus"/>
            </Grid>
        </Grid>
    </Grid>
</local:OverlayPanelWindow>
